# Copy to .env and fill in. With everything empty the app runs in offline mock mode.

# ---- LLM ----
# Zhipu open-platform key (https://open.bigmodel.cn) — used by the zhipu backend
ZHIPUAI_API_KEY=
# Or: any Anthropic-compatible gateway (Zhipu Coding Plan / self-hosted proxy); pick one of the two
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
# Optional overrides: LLM_PROVIDER=zhipu|anthropic_compat|mock   LLM_MODEL=<model id>
# Thinking effort: keep "low" for GLM-5.x (the heavy default thinking starves the output
# budget); use "default" for models that do not accept the thinking parameter
LLM_THINKING=low

# ---- Retrieval / orchestration ----
EMBEDDING_PROVIDER=local
RETRIEVAL_TOP_K=3
RETRIEVAL_QUERY_REWRITE=false
CRITIC_ALLOW_RETURN=false
